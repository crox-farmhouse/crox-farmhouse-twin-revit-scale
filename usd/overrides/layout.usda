#usda 1.0
(
    defaultPrim = "CroxFarmhouse"
    doc = "Crox Farmhouse non-destructive layout & annotation override layer"
    metersPerUnit = 1
    upAxis = "Y"
)

over "CroxFarmhouse"
{
    over "Zones"
    {
        over "courtyard"
        {
            over "outbuildings_store_loftFloor" (
                doc = "FLoorboards like in plant room"
            )
            {
                custom int twin:annotationId = 1
                custom double3 twin:hitWorldPoint = (-8.251, 2.61, 18.443)
                custom string twin:note = "FLoorboards like in plant room"
            }

            over "outbuildings_barn_golfSimulator_oakLintel_beam" (
                doc = "No baseboards up here. Just put some clear storage boxes full of stuff"
            )
            {
                custom int twin:annotationId = 2
                custom double3 twin:hitWorldPoint = (-7.363, 2.72, 17.168)
                custom string twin:note = "No baseboards up here. Just put some clear storage boxes full of stuff"
            }
        }
    }
}
